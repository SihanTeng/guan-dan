#!/usr/bin/env bash
# Pre-commit: formatting, linting, type-checking (Rust)
# Install: make hooks   OR   git config core.hooksPath .githooks

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

info()  { echo -e "${BLUE}[pre-commit]${NC} $1"; }
ok()    { echo -e "${GREEN}[pre-commit]${NC} $1"; }
fail()  { echo -e "${RED}[pre-commit]${NC} $1"; exit 1; }
warn()  { echo -e "${YELLOW}[pre-commit]${NC} $1"; }

# Only run when Rust sources staged (or always if no staging filter needed)
STAGED_RS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.rs$|Cargo\.(toml|lock)$' || true)
if [ -z "$STAGED_RS" ]; then
  info "No Rust changes staged — skipping checks"
  exit 0
fi

info "Rust changes detected — running fmt / clippy / check"

if ! command -v cargo >/dev/null 2>&1; then
  fail "cargo not found; install Rust from https://rustup.rs"
fi

# 1) Formatting
info "cargo fmt --check"
if ! cargo fmt --all -- --check; then
  fail "Formatting failed. Run: cargo fmt --all"
fi
ok "fmt OK"

# 2) Lint (clippy) — treat warnings as errors for committed code
info "cargo clippy"
if ! cargo clippy --workspace --all-targets -- -D warnings; then
  fail "Clippy failed. Fix lints or run: cargo clippy --workspace --all-targets -- -D warnings"
fi
ok "clippy OK"

# 3) Type-check / compile
info "cargo check"
if ! cargo check --workspace --all-targets; then
  fail "cargo check failed"
fi
ok "check OK"

ok "All pre-commit checks passed ✓"
exit 0
